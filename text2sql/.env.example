# Use an exact model tag from ollama list; cloud models require Ollama sign-in.
LLM_MODEL=gpt-oss:120b-cloud
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=120
DATABASE_URL=postgresql+psycopg://text2sql_reader:12345@localhost:5432/postgres
# AQI history and predictions only; pgvector-related tables are excluded.
ALLOWED_TABLES=public.air_quality_hourly,public.air_quality_predictions,public.air_quality_predictions_8h
STATEMENT_TIMEOUT_MS=5000
MAX_RESULT_ROWS=100
